@baseUrl = http://localhost:8080/api/v1

# ---------------------------------------------------------------------------------------------------
# 명세 7절 제출 사례 — 정상 24개(A01~A24 의 첫 번째 정상 요청) + 오류 6개(아래 [제출 ...] 표시)
#   400 입력 오류 2개 : [제출 400-1] A08 name 공백 (필수 문자열)   [제출 400-2] A11 수량 21 (정수 범위)
#   404 대상 없음 1개 : [제출 404-1] A07 존재하지 않는 메뉴
#   409 업무 위반 3개 : [제출 409-1] A03 카테고리 이름 중복   [제출 409-2] A11 배송지 불일치   [제출 409-3] A10 주문에 사용된 메뉴 삭제
# 나머지 실패 항목은 검증용 추가 사례입니다. 실행 순서는 파일 순서를 따르고, 준비 데이터와 변수는 각 항목 주석을 참고하세요.
# ---------------------------------------------------------------------------------------------------

### A01 카테고리 목록
GET {{baseUrl}}/categories

### A02 카테고리 상세
@searchCategoryId=1
GET {{baseUrl}}/categories/{{searchCategoryId}}

### A02 카테고리 상세 실패 (잘못된 categoryId)
@invalidCategoryId = abc12345
GET {{baseUrl}}/categories/{{invalidCategoryId}}

### A03 카테고리 등록
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "new category"
}

### [제출 409-1] A03 카테고리 등록 실패 (중복 카테고리) — 기대: 409 CATEGORY_NAME_DUPLICATED, fieldErrors={}
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "new category"
}

### A03 카테고리 등록 실패 (name 필드 공백)
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "   "
}

### A04 카테고리 수정 성공
@updateCategoryId=2
PUT {{baseUrl}}/categories/{{updateCategoryId}}
Content-Type: application/json

{
  "name": "updated name"
}

### A04 카테고리 수정 실패 (카테고리 이름 중복)
PUT {{baseUrl}}/categories/{{updateCategoryId}}
Content-Type: application/json

{
  "name": "Single Origin"
}

### A04 카테고리 수정 실패 (카테고리 이름 공백)
PUT {{baseUrl}}/categories/{{updateCategoryId}}
Content-Type: application/json

{
  "name": ""
}

### A04 카테고리 수정 실패 (카테고리 이름 타입)
@updateCategoryIdWithInvalidType = asd9999
PUT {{baseUrl}}/categories/{{updateCategoryIdWithInvalidType}}
Content-Type: application/json

{
  "name": "asdasd"
}

### A04 카테고리 수정 실패 (존재하지 않는 카테고리 ID)
@updateCategoryIdNotFound = 99999999
PUT {{baseUrl}}/categories/{{updateCategoryIdNotFound}}
Content-Type: application/json

{
  "name": "asdasd"
}

### A05 카테고리 삭제 성공 (카테고리 등록 테스트 후 진행)
@deleteCategoryId=3
DELETE {{baseUrl}}/categories/{{deleteCategoryId}}

### A05 카테고리 삭제 실패 (카테고리 이름 타입)
@deleteCategoryIdWithInvalidType = asd9999
DELETE {{baseUrl}}/categories/{{deleteCategoryIdWithInvalidType}}

### A05 카테고리 삭제 실패 (존재하지 않는 카테고리 ID)
@deleteCategoryIdNotFound = 99999999
DELETE {{baseUrl}}/categories/{{deleteCategoryIdNotFound}}

### A06 전체 메뉴 조회 (기대: 200, Menu[] ID 오름차순, 판매 중지 메뉴 포함)
GET {{baseUrl}}/menus

### A07 메뉴 상세 조회 (기대: 200, id·categoryId·name·price·description·available)
@searchMenuId=1
GET {{baseUrl}}/menus/{{searchMenuId}}

### [제출 404-1] A07 메뉴 상세 조회 실패 (존재하지 않는 메뉴) — 기대: 404 MENU_NOT_FOUND, fieldErrors={}
@invalidMenuId=99999999
GET {{baseUrl}}/menus/{{invalidMenuId}}

### A07 메뉴 상세 조회 실패 (유효하지 않은 메뉴 ID 타입) — 기대: 400 VALIDATION_ERROR, fieldErrors.menuId
@searchMenuIdWithInvalidType=asd123
GET {{baseUrl}}/menus/{{searchMenuIdWithInvalidType}}

### A07 메뉴 상세 조회 실패 (메뉴 ID 0) — 기대: 400 VALIDATION_ERROR
GET {{baseUrl}}/menus/0

### A08 메뉴 등록 (기대: 201, available=true 로 생성된 Menu / 응답 id 를 아래 @createdMenuId 에 적을 것)
POST {{baseUrl}}/menus
Content-Type: application/json

{
  "categoryId": 2,
  "name": "House Blend",
  "price": 6000,
  "description": "블렌드 원두 패키지입니다."
}

### [제출 400-1] A08 메뉴 등록 실패 (name 공백) — 기대: 400 VALIDATION_ERROR, fieldErrors.name
POST {{baseUrl}}/menus
Content-Type: application/json

{
  "categoryId": 1,
  "name": "",
  "price": 6000,
  "description": ""
}

### A08 메뉴 등록 실패 (price 0) — 기대: 400 VALIDATION_ERROR, fieldErrors.price
POST {{baseUrl}}/menus
Content-Type: application/json

{
  "categoryId": 1,
  "name": "Zero Price",
  "price": 0,
  "description": ""
}

### A08 메뉴 등록 실패 (price 자료형 오류) — 기대: 400 VALIDATION_ERROR, fieldErrors.price
POST {{baseUrl}}/menus
Content-Type: application/json

{
  "categoryId": 1,
  "name": "String Price",
  "price": "abc",
  "description": ""
}

### A08 메뉴 등록 실패 (존재하지 않는 카테고리) — 기대: 404 CATEGORY_NOT_FOUND
POST {{baseUrl}}/menus
Content-Type: application/json

{
  "categoryId": 99999999,
  "name": "No Category",
  "price": 1000,
  "description": ""
}

### A09 메뉴 일반 수정 (기대: 200, 네 필드가 바뀌고 available 은 기존 값 유지)
@createdMenuId=6
PUT {{baseUrl}}/menus/{{createdMenuId}}
Content-Type: application/json

{
  "categoryId": 2,
  "name": "House Blend (Updated)",
  "price": 6500,
  "description": "블렌드 원두 패키지입니다. (수정)"
}

### A09 메뉴 수정 실패 (존재하지 않는 메뉴) — 기대: 404 MENU_NOT_FOUND
PUT {{baseUrl}}/menus/{{invalidMenuId}}
Content-Type: application/json

{
  "categoryId": 1,
  "name": "Ghost",
  "price": 1000,
  "description": ""
}

### A09 메뉴 수정 실패 (메뉴 ID 타입) — 기대: 400 VALIDATION_ERROR, fieldErrors.menuId
PUT {{baseUrl}}/menus/{{searchMenuIdWithInvalidType}}
Content-Type: application/json

{
  "categoryId": 1,
  "name": "Ghost",
  "price": 1000,
  "description": ""
}

### A09 메뉴 수정 실패 (name 공백) — 기대: 400 VALIDATION_ERROR, fieldErrors.name
PUT {{baseUrl}}/menus/{{createdMenuId}}
Content-Type: application/json

{
  "categoryId": 1,
  "name": "   ",
  "price": 1000,
  "description": ""
}

### A15 카테고리별 메뉴 (기대: 200, 카테고리 1 소속 Menu[] ID 오름차순)
@menuListCategoryId=1
GET {{baseUrl}}/categories/{{menuListCategoryId}}/menus

### A15 카테고리별 메뉴 (소속 메뉴 없음) — 기대: 200 + []  (카테고리 등록 테스트 후 생성된 ID 사용)
@emptyCategoryId=4
GET {{baseUrl}}/categories/{{emptyCategoryId}}/menus

### A15 카테고리별 메뉴 실패 (존재하지 않는 카테고리) — 기대: 404 CATEGORY_NOT_FOUND, fieldErrors={}
GET {{baseUrl}}/categories/{{updateCategoryIdNotFound}}/menus

### A15 카테고리별 메뉴 실패 (카테고리 ID 타입) — 기대: 400 VALIDATION_ERROR, fieldErrors.categoryId
GET {{baseUrl}}/categories/{{invalidCategoryId}}/menus

### A19 판매 중 메뉴 (기대: 200, available=true 인 Menu[] 만, ID 오름차순 / A21 로 중지한 메뉴는 빠져야 함)
GET {{baseUrl}}/menus/available

### A20 메뉴명 검색 (기대: 200, "Columbia" 가 들어간 메뉴 1·3)
GET {{baseUrl}}/menus/search?keyword=Columbia

### A20 메뉴명 검색 (결과 없음) — 기대: 200 + []
GET {{baseUrl}}/menus/search?keyword=NoSuchMenu

### A20 메뉴명 검색 실패 (검색어 누락) — 기대: 400 VALIDATION_ERROR, fieldErrors.keyword
GET {{baseUrl}}/menus/search

### A20 메뉴명 검색 실패 (검색어 공백) — 기대: 400 VALIDATION_ERROR (앞뒤 공백 제거 후 1~100자)
GET {{baseUrl}}/menus/search?keyword=





### A21 판매 여부 변경 — 중지 (기대: 200, available=false 인 전체 Menu / 이후 A19 에서 빠지는지 확인)
PUT {{baseUrl}}/menus/{{createdMenuId}}/availability
Content-Type: application/json

{
  "available": false
}

### A21 판매 여부 변경 — 재개 (기대: 200, available=true)
PUT {{baseUrl}}/menus/{{createdMenuId}}/availability
Content-Type: application/json

{
  "available": true
}

### A21 판매 여부 변경 실패 (문자열) — 기대: 400 VALIDATION_ERROR, fieldErrors.available
PUT {{baseUrl}}/menus/{{createdMenuId}}/availability
Content-Type: application/json

{
  "available": "yes"
}

### A21 판매 여부 변경 실패 (available 누락) — 기대: 400 VALIDATION_ERROR, fieldErrors.available
PUT {{baseUrl}}/menus/{{createdMenuId}}/availability
Content-Type: application/json

{}

### A21 판매 여부 변경 실패 (존재하지 않는 메뉴) — 기대: 404 MENU_NOT_FOUND, fieldErrors={}
PUT {{baseUrl}}/menus/{{invalidMenuId}}/availability
Content-Type: application/json

{
  "available": false
}

### A21 판매 여부 변경 실패 (메뉴 ID 타입) — 기대: 400 VALIDATION_ERROR, fieldErrors.menuId
PUT {{baseUrl}}/menus/{{searchMenuIdWithInvalidType}}/availability
Content-Type: application/json

{

  "available": false
}

### A21 판매 여부 변경 실패 (메뉴 ID 0) — 기대: 400 VALIDATION_ERROR, fieldErrors.menuId
PUT {{baseUrl}}/menus/0/availability
Content-Type: application/json

{
  "available": false
}


### A11 주문 접수 (기대: 201, totalAmount=17000, status=PLACED, cancelledAt=null, memo="" / 응답 id 를 @orderId 에 적을 것)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "email": "buyer@example.com",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
  "items": [
    {
      "menuId": 1,
      "quantity": 2
    },
    {
      "menuId": 2,
      "quantity": 1
    }
  ]
}

### A11 주문 접수 (같은 묶음에 추가 주문 — A14 배송 묶음 확인용) — 기대: 201
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "email": "buyer@example.com",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
  "items": [
    {
      "menuId": 1,
      "quantity": 1
    }
  ]
}

### A11 주문 접수 (A23 판매 중지 재주문·A10 MENU_IN_USE 확인용 — {{createdMenuId}} 로 주문) — 기대: 201 / 응답 id 를 @unavailableMenuOrderId 에 적을 것
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "email": "buyer@example.com",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
  "items": [
    {
      "menuId": {{createdMenuId}},
      "quantity": 1
    }
  ]
}

### A11 주문 접수 실패 (이메일 형식) — 기대: 400 VALIDATION_ERROR, fieldErrors.email
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "email": "not-an-email",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
  "items": [
    {
      "menuId": 1,
      "quantity": 1
    }
  ]
}

### A11 주문 접수 실패 (items 비어 있음) — 기대: 400 VALIDATION_ERROR, fieldErrors.items
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "email": "buyer@example.com",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
  "items": []
}

### A11 주문 접수 실패 (수량 0) — 기대: 400 VALIDATION_ERROR, fieldErrors.items (1~20)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "email": "buyer@example.com",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
  "items": [
    {
      "menuId": 1,
      "quantity": 0
    }
  ]
}

### [제출 400-2] A11 주문 접수 실패 (수량 21) — 기대: 400 VALIDATION_ERROR, fieldErrors.items
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "email": "buyer@example.com",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
  "items": [
    {
      "menuId": 1,
      "quantity": 21
    }
  ]
}

### A11 주문 접수 실패 (menuId 중복) — 기대: 400 VALIDATION_ERROR, fieldErrors.items
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "email": "buyer@example.com",
  "address": "서울시 실습로 10 101호",
  "postcode": "01234",
